# Configurações do Sistema de Avaliações

# Ambiente
NODE_ENV=production

# Configurações do Banco de Dados
POSTGRES_DB=sistema_avaliacoes
POSTGRES_USER=avaliacoes_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Configurações Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Configurações da Aplicação
APP_NAME=Sistema de Avaliações
APP_VERSION=1.0.0
APP_PORT=80

# Configurações de Segurança
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_session_secret_here

# Configurações de Email (futuro)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sistema-avaliacoes.com

# Configurações de Upload
MAX_FILE_SIZE=10MB
UPLOAD_PATH=/uploads

# Configurações de Logs
LOG_LEVEL=info
LOG_FILE=/logs/app.log

# URLs Externas
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:8080

# Configurações de Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Diário às 2h
BACKUP_RETENTION_DAYS=30
