# ===================================
# Docker Environment Configuration
# ===================================

# Application
APP_NAME=sistema-avaliacoes
APP_ENV=development
APP_VERSION=1.0.0

# Database
DB_CONNECTION=postgresql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=sistema_avaliacoes
DB_USERNAME=avaliacoes_user
DB_PASSWORD=avaliacoes_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=avaliacoes2024

# JWT
JWT_SECRET_KEY=/var/www/html/config/jwt/private.pem
JWT_PUBLIC_KEY=/var/www/html/config/jwt/public.pem
JWT_PASSPHRASE=avaliacoes2024

# CORS
CORS_ALLOW_ORIGIN=http://localhost:4200

# Mailer
MAILER_DSN=smtp://localhost

# Ports (Development)
FRONTEND_PORT=4200
BACKEND_PORT=8081
DATABASE_PORT=5432
REDIS_PORT=6379

# Ports (Production)
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
PROD_NGINX_PORT=8080
