# Minimal Development Dockerfile - for testing
FROM php:8.2-fpm-alpine

# Install only essential system dependencies
RUN apk add --no-cache \
    postgresql-dev \
    icu-dev

# Install only essential PHP extensions
RUN docker-php-ext-install \
    pdo \
    pdo_pgsql \
    intl

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configure Composer
ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_MEMORY_LIMIT=-1

# Set working directory
WORKDIR /var/www/html

# Copy application files
COPY . .

# Try to install dependencies, but don't fail if it doesn't work
RUN composer install --no-scripts --no-autoloader --no-dev --prefer-dist --ignore-platform-reqs || \
    echo "Warning: Composer install failed, continuing without vendor dependencies"

# Create basic autoloader if vendor doesn't exist
RUN if [ ! -d "vendor" ]; then mkdir -p vendor && echo '<?php' > vendor/autoload.php; fi

# Set permissions
RUN chown -R www-data:www-data /var/www/html

# Expose port 9000
EXPOSE 9000

# Start PHP-FPM
CMD ["php-fpm"]
