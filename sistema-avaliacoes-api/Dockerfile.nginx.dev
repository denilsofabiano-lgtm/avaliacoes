# Simple Nginx for Development
FROM nginx:alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy nginx configuration for development
COPY nginx.dev.conf /etc/nginx/conf.d/default.conf

# Create document root
RUN mkdir -p /usr/share/nginx/html

# Copy public directory (Symfony's public files)
COPY public/ /usr/share/nginx/html/

# Create a simple info page for testing
RUN echo 'Sistema de Avaliações API - Development' > /usr/share/nginx/html/info.html

# Set permissions
RUN chown -R nginx:nginx /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
