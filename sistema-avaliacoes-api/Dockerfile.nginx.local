# Nginx for Local Development (127.0.0.1)
FROM nginx:alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy nginx configuration for localhost
COPY nginx.local.conf /etc/nginx/conf.d/default.conf

# Create document root
RUN mkdir -p /usr/share/nginx/html

# Copy public directory (Symfony's public files)
COPY public/ /usr/share/nginx/html/

# Create debug files for localhost testing
RUN echo '<h1>Sistema de Avaliações API</h1><p>Running on localhost</p><p><a href="/health">Health Check</a> | <a href="/debug">Debug Info</a></p>' > /usr/share/nginx/html/index.html
RUN echo '<?php phpinfo(); ?>' > /usr/share/nginx/html/phpinfo.php

# Set permissions
RUN chown -R nginx:nginx /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
